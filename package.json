{
	"name": "@anmiles/theme-switcher",
	"version": "2.0.7",
	"description": "Theme switcher for websites",
	"keywords": [
		"theme",
		"switcher",
		"websites"
	],
	"author": "Anatoliy Oblaukhov",
	"homepage": "https://github.com/anmiles/theme-switcher",
	"repository": "github:anmiles/theme-switcher",
	"license": "MIT",
	"engines": {
		"node": ">=24.18.0"
	},
	"main": "src/index.tsx",
	"scripts": {
		"spellcheck": "cspell .",
		"prebuild": "rimraf dist && tsc --noEmit",
		"build": "npm-run-all build:*",
		"build:development": "vite build --mode development",
		"build:production": "vite build --mode production",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"test": "jest --verbose",
		"test:coverage": "npm test -- --coverage",
		"test:ci": "npm test -- --ci --coverage",
		"test:watch": "npm test -- --watch",
		"test:watch:coverage": "npm test -- --watch --coverage",
		"test:report:coverage": "nyc report",
		"dev": "vite --mode development",
		"start": "node ./server.mjs",
		"start:development": "npm start development",
		"start:production": "npm start production"
	},
	"dependencies": {
		"@anmiles/express-tools": "^3.0.0",
		"@anmiles/logger": "^9.0.0",
		"express": "^5.2.1",
		"npm-run-all": "^4.1.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@anmiles/eslint-config": "^11.0.0",
		"@anmiles/tsconfig": "^5.0.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/css": "^2.0.0",
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^2.1.0",
		"@eslint/markdown": "^8.0.3",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.3.20",
		"@types/react-dom": "^18.3.6",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@vitejs/plugin-react": "^6.1.1",
		"cspell": "^10.3.3",
		"css-loader": "^7.1.5",
		"eslint": "^9.39.2",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-align-assignments": "^1.1.2",
		"eslint-plugin-i18next": "^6.1.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-redux": "^4.2.2",
		"eslint-plugin-react-refresh": "^0.5.7",
		"glob": "^13.0.6",
		"jest": "^30.5.1",
		"jest-environment-jsdom": "^30.5.1",
		"jiti": "^2.7.0",
		"nyc": "^18.0.0",
		"react-refresh": "^0.19.0",
		"react-refresh-typescript": "^2.0.12",
		"rimraf": "^6.1.3",
		"style-loader": "^4.0.0",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plugin-lib-inject-css": "^2.2.2"
	}
}
